<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared only by the two equipment editors. Business state remains in their code-behind. -->
    <Color
        x:Key="EquipmentRedColor">#E2000A</Color>
    <SolidColorBrush
        x:Key="EquipmentInk"
        Color="#25252C" />
    <SolidColorBrush
        x:Key="EquipmentGridLine"
        Color="#D1CED7" />
    <SolidColorBrush
        x:Key="EquipmentSelection"
        Color="#F8CDD8" />
    <SolidColorBrush
        x:Key="EquipmentAlternatingRow"
        Color="#F3F2F7" />
    <CornerRadius
        x:Key="EquipmentPanelRadius">18</CornerRadius>
    <CornerRadius
        x:Key="EquipmentSquareCorners">0</CornerRadius>
    <CornerRadius
        x:Key="EquipmentCloseCorners">0,10,0,0</CornerRadius>
    <Duration
        x:Key="EquipmentHoverDuration">0:0:0.10</Duration>
    <Duration
        x:Key="EquipmentPressDuration">0:0:0.05</Duration>
    <Duration
        x:Key="EquipmentReturnDuration">0:0:0.10</Duration>
    <CornerRadius
        x:Key="EquipmentPanelHeaderRadius">17,17,0,0</CornerRadius>
    <CornerRadius
        x:Key="EquipmentActionRadius">10</CornerRadius>
    <CornerRadius
        x:Key="EquipmentActionFocusRadius">12</CornerRadius>
    <LinearGradientBrush
        x:Key="EquipmentActionBrush"
        StartPoint="0,0"
        EndPoint="0.8,1">
        <GradientStop
            Color="#FF1523"
            Offset="0" />
        <GradientStop
            Color="{StaticResource EquipmentRedColor}"
            Offset="0.48" />
        <GradientStop
            Color="#BA0004"
            Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="EquipmentDisabledBrush"
        StartPoint="0,0"
        EndPoint="0,1">
        <GradientStop
            Color="#F1EFF1"
            Offset="0" />
        <GradientStop
            Color="#DCDADD"
            Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="EquipmentColumnBrush"
        StartPoint="0,0"
        EndPoint="0,1">
        <GradientStop
            Color="#FEFEFF"
            Offset="0" />
        <GradientStop
            Color="#ECEBF1"
            Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="EquipmentSectionGradient"
        StartPoint="0,0"
        EndPoint="1,0">
        <GradientStop
            Color="#F1000C"
            Offset="0" />
        <GradientStop
            Color="#CE0005"
            Offset="0.48" />
        <GradientStop
            Color="#F74654"
            Offset="0.78" />
        <GradientStop
            Color="#FCEBED"
            Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush
        x:Key="EquipmentSectionBrush"
        Viewbox="0,0,1240,38"
        ViewboxUnits="Absolute"
        Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="{StaticResource EquipmentSectionGradient}"
                    Geometry="M0,0 H1240 V38 H0 Z" />
                <GeometryDrawing
                    Geometry="M350,38 C570,16 613,28 760,0 H1000 C794,24 719,24 630,38 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush
                            Color="#FF6A74"
                            Opacity="0.16" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush
        x:Key="EquipmentCaptionBrush"
        Viewbox="0,0,1280,48"
        ViewboxUnits="Absolute"
        Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="{StaticResource EquipmentActionBrush}"
                    Geometry="M0,0 H1280 V48 H0 Z" />
                <GeometryDrawing
                    Geometry="M128,48 L356,0 H532 L301,48 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush
                            Color="#FF6974"
                            Opacity="0.55" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing
                    Brush="#FFF9FA"
                    Geometry="M342,50 C567,7 603,8 720,0 H1098 C923,85 810,41 630,50 Z" />
                <GeometryDrawing
                    Brush="#F8DFE5"
                    Geometry="M936,50 L1036,0 H1098 L1013,50 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush
        x:Key="EquipmentPageBrush"
        Viewbox="0,0,1280,736"
        ViewboxUnits="Absolute"
        Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="#FFFAFB"
                    Geometry="M0,0 H1280 V736 H0 Z" />
                <GeometryDrawing
                    Brush="#FBE6EB"
                    Geometry="M0,690 C178,665 324,750 541,703 C746,662 934,752 1280,678 V736 H0 Z" />
                <GeometryDrawing
                    Brush="#F9D8E0"
                    Geometry="M0,714 C263,660 341,735 569,724 C860,675 1026,697 1280,681 V736 H0 Z" />
                <GeometryDrawing
                    Brush="{StaticResource EquipmentActionBrush}"
                    Geometry="M0,697 C122,758 246,742 396,736 C654,657 801,712 950,736 H1280 V681 C1150,743 1054,738 896,720 C682,674 582,727 430,736 H0 Z" />
                <GeometryDrawing
                    Geometry="M666,736 C898,701 1033,749 1206,708 L1280,693 V736 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush
                            Color="#FF6674"
                            Opacity="0.48" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Small vector icons have no animated effects or external font dependencies. -->
    <StreamGeometry
        x:Key="EquipmentAddGeometry">M9,2 V16 M2,9 H16</StreamGeometry>
    <StreamGeometry
        x:Key="EquipmentEditGeometry">M3,12 L12,3 16,7 7,16 2,17 Z M10,5 L14,9 M2,17 H17</StreamGeometry>
    <StreamGeometry
        x:Key="EquipmentDeleteGeometry">M3,5 H15 M7,2 H11 V5 M5,5 V17 H13 V5 M8,8 V14 M10,8 V14</StreamGeometry>
    <StreamGeometry
        x:Key="EquipmentSaveGeometry">M2,2 H14 L17,5 V17 H2 Z M5,2 V8 H13 V2 M5,17 V11 H14 V17</StreamGeometry>
    <StreamGeometry
        x:Key="EquipmentCancelGeometry">M3,3 L15,15 M15,3 L3,15</StreamGeometry>
    <StreamGeometry
        x:Key="EquipmentRefreshGeometry">M15,5 A7,7 0 1 0 16,11 M15,1 V6 H10</StreamGeometry>
    <DrawingImage
        x:Key="EquipmentAntennaIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="White">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry
                            Center="16,12"
                            RadiusX="2.5"
                            RadiusY="2.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing
                    Geometry="M16,14 L7,34 M16,14 L25,34 M9,30 L22,25 L12,20 M23,30 L10,25 L20,20 M7,2 C1,8 1,14 7,20 M11,6 C7,10 7,13 11,16 M25,2 C31,8 31,14 25,20 M21,6 C25,10 25,13 21,16">
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="White"
                            Thickness="2.1"
                            StartLineCap="Round"
                            EndLineCap="Round"
                            LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage
        x:Key="EquipmentRruIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Geometry="M7,3 H25 V29 H7 Z M3,8 V24 M29,8 V24 M11,32 V35 M16,32 V35 M21,32 V35 M10,5 V27 M14,5 V27 M18,5 V27 M22,5 V27">
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="White"
                            Thickness="1.8"
                            StartLineCap="Round"
                            EndLineCap="Round"
                            LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage
        x:Key="EquipmentPortsIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing
                Geometry="M3,3 H29 V18 H22 L20,23 H12 L10,18 H3 Z M7,7 V14 M11,7 V14 M15,7 V14 M19,7 V14 M23,7 V14 M11,23 L16,29 L21,23">
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="White"
                        Thickness="2"
                        StartLineCap="Round"
                        EndLineCap="Round"
                        LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage
        x:Key="EquipmentStandardsIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="White"
                    Geometry="M2,9 L16,1 30,9 16,17 Z" />
                <GeometryDrawing
                    Geometry="M2,16 L16,24 30,16 M2,23 L16,31 30,23">
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="White"
                            Thickness="3"
                            StartLineCap="Round"
                            EndLineCap="Round"
                            LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style
        x:Key="EquipmentFrame"
        TargetType="Border">
        <Setter
            Property="CornerRadius"
            Value="11" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Maximized">
                <Setter
                    Property="CornerRadius"
                    Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="EquipmentCaption"
        TargetType="Border">
        <Setter
            Property="CornerRadius"
            Value="10,10,0,0" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Maximized">
                <Setter
                    Property="CornerRadius"
                    Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="EquipmentSection"
        TargetType="GroupBox">
        <Setter
            Property="Padding"
            Value="9,0,9,4" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="GroupBox">
                    <Grid>
                        <Border
                            CornerRadius="{StaticResource EquipmentPanelRadius}"
                            Background="#16DB304B"
                            Margin="-2,1,-2,-4"
                            IsHitTestVisible="False" />
                        <Border
                            CornerRadius="{StaticResource EquipmentPanelRadius}"
                            Background="#0FDC3A53"
                            Margin="-4,1,-4,-7"
                            IsHitTestVisible="False" />
                        <Border
                            CornerRadius="{StaticResource EquipmentPanelRadius}"
                            Background="#FFFBFC"
                            BorderBrush="#F2CED7"
                            BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="38" />
                                    <RowDefinition
                                        Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    CornerRadius="{StaticResource EquipmentPanelHeaderRadius}"
                                    Background="{StaticResource EquipmentSectionBrush}">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        Margin="20,0,12,0"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                                </Border>
                                <ContentPresenter
                                    Grid.Row="1"
                                    Margin="{TemplateBinding Padding}"
                                    ContentSource="Content" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="EquipmentSectionTitle"
        TargetType="TextBlock">
        <Setter
            Property="FontFamily"
            Value="Segoe UI" />
        <Setter
            Property="FontSize"
            Value="20" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="White" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
        <Setter
            Property="Margin"
            Value="14,0,0,0" />
    </Style>
    <Style
        x:Key="EquipmentGrid"
        TargetType="DataGrid">
        <Setter
            Property="FontFamily"
            Value="Segoe UI" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="Foreground"
            Value="{StaticResource EquipmentInk}" />
        <Setter
            Property="Background"
            Value="#FFFEFF" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource EquipmentGridLine}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="RowBackground"
            Value="White" />
        <Setter
            Property="AlternatingRowBackground"
            Value="{StaticResource EquipmentAlternatingRow}" />
        <Setter
            Property="AlternationCount"
            Value="2" />
        <Setter
            Property="RowHeight"
            Value="22" />
        <Setter
            Property="ColumnHeaderHeight"
            Value="26" />
        <Setter
            Property="HeadersVisibility"
            Value="Column" />
        <Setter
            Property="HorizontalGridLinesBrush"
            Value="{StaticResource EquipmentGridLine}" />
        <Setter
            Property="VerticalGridLinesBrush"
            Value="{StaticResource EquipmentGridLine}" />
        <Setter
            Property="GridLinesVisibility"
            Value="All" />
        <Setter
            Property="EnableRowVirtualization"
            Value="True" />
        <Setter
            Property="EnableColumnVirtualization"
            Value="True" />
        <Setter
            Property="VirtualizingPanel.IsVirtualizing"
            Value="True" />
        <Setter
            Property="VirtualizingPanel.VirtualizationMode"
            Value="Recycling" />
        <Setter
            Property="ScrollViewer.CanContentScroll"
            Value="True" />
        <Setter
            Property="VirtualizingPanel.ScrollUnit"
            Value="Pixel" />
        <Setter
            Property="ScrollViewer.HorizontalScrollBarVisibility"
            Value="Visible" />
        <Setter
            Property="ScrollViewer.VerticalScrollBarVisibility"
            Value="Visible" />
        <Setter
            Property="RowStyle">
            <Setter.Value>
                <Style
                    TargetType="DataGridRow">
                    <Setter
                        Property="BorderThickness"
                        Value="0" />
                    <Setter
                        Property="Foreground"
                        Value="{StaticResource EquipmentInk}" />
                    <Style.Triggers>
                        <Trigger
                            Property="IsSelected"
                            Value="True">
                            <Setter
                                Property="Background"
                                Value="{StaticResource EquipmentSelection}" />
                            <Setter
                                Property="Foreground"
                                Value="{StaticResource EquipmentInk}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter
            Property="CellStyle">
            <Setter.Value>
                <Style
                    TargetType="DataGridCell">
                    <Setter
                        Property="Background"
                        Value="Transparent" />
                    <Setter
                        Property="BorderBrush"
                        Value="Transparent" />
                    <Setter
                        Property="BorderThickness"
                        Value="1" />
                    <Setter
                        Property="Padding"
                        Value="5,0" />
                    <Setter
                        Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    <Setter
                        Property="FocusVisualStyle"
                        Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger
                            Property="IsKeyboardFocusWithin"
                            Value="True">
                            <Setter
                                Property="BorderBrush"
                                Value="#D84B60" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter
            Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style
                    TargetType="DataGridColumnHeader">
                    <Setter
                        Property="Background"
                        Value="{StaticResource EquipmentColumnBrush}" />
                    <Setter
                        Property="Foreground"
                        Value="{StaticResource EquipmentInk}" />
                    <Setter
                        Property="FontWeight"
                        Value="SemiBold" />
                    <Setter
                        Property="Padding"
                        Value="10,0,6,0" />
                    <Setter
                        Property="BorderBrush"
                        Value="{StaticResource EquipmentGridLine}" />
                    <Setter
                        Property="ToolTip"
                        Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                    <Setter
                        Property="BorderThickness"
                        Value="0,0,1,1" />
                    <Setter
                        Property="HorizontalContentAlignment"
                        Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="EquipmentCellText"
        TargetType="TextBlock">
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
        <Setter
            Property="Margin"
            Value="8,0,4,0" />
        <Setter
            Property="TextWrapping"
            Value="NoWrap" />
        <Setter
            Property="TextTrimming"
            Value="CharacterEllipsis" />
        <Setter
            Property="ToolTip"
            Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style
        x:Key="EquipmentEditingText"
        TargetType="TextBox">
        <Setter
            Property="Padding"
            Value="4,0" />
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="Background"
            Value="#FFFDFE" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="BorderBrush"
            Value="#D84B60" />
        <Setter
            Property="TextWrapping"
            Value="NoWrap" />
        <Setter
            Property="AcceptsReturn"
            Value="False" />
        <Setter
            Property="VerticalScrollBarVisibility"
            Value="Disabled" />
    </Style>
    <Style
        x:Key="EquipmentComboDisplay"
        TargetType="ComboBox"
        BasedOn="{x:Static DataGridComboBoxColumn.DefaultElementStyle}">
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="Padding"
            Value="6,0,3,0" />
    </Style>
    <Style
        x:Key="EquipmentComboEditor"
        TargetType="ComboBox"
        BasedOn="{x:Static DataGridComboBoxColumn.DefaultEditingElementStyle}">
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="Padding"
            Value="4,0" />
        <Setter
            Property="MinWidth"
            Value="70" />
        <Setter
            Property="MaxDropDownHeight"
            Value="260" />
    </Style>
    <Style
        x:Key="EquipmentCheckDisplay"
        TargetType="CheckBox"
        BasedOn="{x:Static DataGridCheckBoxColumn.DefaultElementStyle}">
        <Setter
            Property="HorizontalAlignment"
            Value="Center" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
    </Style>
    <Style
        x:Key="EquipmentCheckEditor"
        TargetType="CheckBox"
        BasedOn="{x:Static DataGridCheckBoxColumn.DefaultEditingElementStyle}">
        <Setter
            Property="HorizontalAlignment"
            Value="Center" />
        <Setter
            Property="VerticalAlignment"
            Value="Center" />
    </Style>
    <Style
        x:Key="EquipmentActionButton"
        TargetType="Button">
        <Setter
            Property="Width"
            Value="96" />
        <Setter
            Property="Height"
            Value="34" />
        <Setter
            Property="Margin"
            Value="3" />
        <Setter
            Property="FontFamily"
            Value="Segoe UI" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="Background"
            Value="{StaticResource EquipmentActionBrush}" />
        <Setter
            Property="Foreground"
            Value="White" />
        <Setter
            Property="Cursor"
            Value="Hand" />
        <Setter
            Property="FocusVisualStyle"
            Value="{x:Null}" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        To="MouseOver"
                                        GeneratedDuration="{StaticResource EquipmentHoverDuration}" />
                                    <VisualTransition
                                        To="Pressed"
                                        GeneratedDuration="{StaticResource EquipmentPressDuration}" />
                                    <VisualTransition
                                        To="Normal"
                                        GeneratedDuration="{StaticResource EquipmentReturnDuration}" />
                                    <VisualTransition
                                        To="Disabled"
                                        GeneratedDuration="{StaticResource EquipmentReturnDuration}" />
                                </VisualStateGroup.Transitions>
                                <VisualState
                                    x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DisabledSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.14"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DisabledSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.14"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DisabledSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="DisabledSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            Background="#24D32A43"
                            Margin="0,2,0,-2"
                            IsHitTestVisible="False" />
                        <Border
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            Background="{TemplateBinding Background}" />
                        <Border
                            x:Name="DisabledSurface"
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            Background="{StaticResource EquipmentDisabledBrush}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                        <Border
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush
                                    x:Name="HoverBrush"
                                    Color="White"
                                    Opacity="0" />
                            </Border.Background>
                        </Border>
                        <Border
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush
                                    x:Name="PressBrush"
                                    Color="Black"
                                    Opacity="0" />
                            </Border.Background>
                        </Border>
                        <Border
                            CornerRadius="{StaticResource EquipmentActionRadius}"
                            BorderBrush="#A0FFFFFF"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <Path
                                Data="{TemplateBinding Tag}"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.8"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stretch="Uniform"
                                Width="17"
                                Height="17"
                                Margin="0,0,8,0" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </StackPanel>
                        <Border
                            x:Name="FocusRing"
                            CornerRadius="{StaticResource EquipmentActionFocusRadius}"
                            Margin="-2"
                            BorderBrush="#CF0018"
                            BorderThickness="1.5"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsKeyboardFocused"
                            Value="True">
                            <Setter
                                TargetName="FocusRing"
                                Property="Opacity"
                                Value="1" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                Property="Foreground"
                                Value="#99979C" />
                            <Setter
                                Property="Cursor"
                                Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="EquipmentCaptionButton"
        TargetType="Button">
        <Setter
            Property="Width"
            Value="48" />
        <Setter
            Property="Height"
            Value="46" />
        <Setter
            Property="Foreground"
            Value="White" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="Tag"
            Value="{StaticResource EquipmentSquareCorners}" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition
                                        To="MouseOver"
                                        GeneratedDuration="0:0:0.08" />
                                    <VisualTransition
                                        To="Pressed"
                                        GeneratedDuration="0:0:0.04" />
                                    <VisualTransition
                                        To="Normal"
                                        GeneratedDuration="0:0:0.06" />
                                </VisualStateGroup.Transitions>
                                <VisualState
                                    x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionHoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionPressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionHoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.12"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionPressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionHoverBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="CaptionPressBrush"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.18"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState
                                    x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding Tag}" />
                        <Border
                            CornerRadius="{TemplateBinding Tag}"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush
                                    x:Name="CaptionHoverBrush"
                                    Color="White"
                                    Opacity="0" />
                            </Border.Background>
                        </Border>
                        <Border
                            CornerRadius="{TemplateBinding Tag}"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush
                                    x:Name="CaptionPressBrush"
                                    Color="Black"
                                    Opacity="0" />
                            </Border.Background>
                        </Border>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="EquipmentCloseCaptionButton"
        TargetType="Button"
        BasedOn="{StaticResource EquipmentCaptionButton}">
        <Setter
            Property="Tag"
            Value="{StaticResource EquipmentCloseCorners}" />
        <Style.Triggers>
            <DataTrigger
                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                Value="Maximized">
                <Setter
                    Property="Tag"
                    Value="{StaticResource EquipmentSquareCorners}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>