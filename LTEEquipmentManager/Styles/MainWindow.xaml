<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- These explicit keys are used only by MainWindow. -->
    <SolidColorBrush x:Key="MainInk" Color="#202020"/>
    <SolidColorBrush x:Key="MainRed" Color="#DB0009"/>
    <LinearGradientBrush x:Key="MainPageBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#FFFDFE" Offset="0"/>
        <GradientStop Color="#FCF8FA" Offset="0.6"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MainCaptionGradient" StartPoint="0,0" EndPoint="1,0.5">
        <GradientStop Color="#B40002" Offset="0"/>
        <GradientStop Color="#F5000D" Offset="0.52"/>
        <GradientStop Color="#AC0001" Offset="1"/>
    </LinearGradientBrush>
    <!-- Paint all caption decoration as one background: Border rounds this brush itself. -->
    <DrawingBrush x:Key="MainCaptionBrush" Viewbox="0,0,1280,56" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MainCaptionGradient}" Geometry="M0,0 H1280 V56 H0 Z"/>
                <GeometryDrawing Geometry="M435,56 L655,0 912,0 690,56 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#FF5260" Opacity="0.18"/></GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M645,56 L849,0 961,0 767,56 Z">
                    <GeometryDrawing.Brush><SolidColorBrush Color="#F30012" Opacity="0.2"/></GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <CornerRadius x:Key="MainCaptionSquareCorners">0</CornerRadius>
    <CornerRadius x:Key="MainCaptionCloseCorners">0,10,0,0</CornerRadius>
    <Style x:Key="MainFrameBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="11"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="CornerRadius" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MainHeaderBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="CornerRadius" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <LinearGradientBrush x:Key="MainCardBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FFFCFD" Offset="0.6"/>
        <GradientStop Color="#FCF3F5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MainTileBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FFF4F5" Offset="0"/>
        <GradientStop Color="#FFE6E9" Offset="0.58"/>
        <GradientStop Color="#FACBD2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MainWaveBrush" StartPoint="0.1,0" EndPoint="0.8,1">
        <GradientStop Color="#FF1320" Offset="0"/>
        <GradientStop Color="#EC0007" Offset="0.5"/>
        <GradientStop Color="#AE0000" Offset="1"/>
    </LinearGradientBrush>

    <!-- DrawingImage is vector artwork, not an external bitmap or icon font. -->
    <DrawingImage x:Key="MainAntennaIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MainRed}">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="48,32" RadiusX="8" RadiusY="8"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M48,36 L22,96 M48,36 L74,96 M25,91 L65,75 L36,60 M71,91 L31,75 L60,60 M39,55 L57,55 M23,8 C7,23 7,42 23,57 M31,16 C20,26 20,39 31,49 M73,8 C89,23 89,42 73,57 M65,16 C76,26 76,39 65,49">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MainRed}" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="MainRruIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MainRed}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="19,7,62,81" RadiusX="5" RadiusY="5"/>
                            <RectangleGeometry Rect="8,22,8,51" RadiusX="3" RadiusY="3"/>
                            <RectangleGeometry Rect="84,22,8,51" RadiusX="3" RadiusY="3"/>
                            <RectangleGeometry Rect="26,91,9,7" RadiusX="1" RadiusY="1"/>
                            <RectangleGeometry Rect="46,91,9,7" RadiusX="1" RadiusY="1"/>
                            <RectangleGeometry Rect="66,91,9,7" RadiusX="1" RadiusY="1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M26,9 L26,82 M34,8 L34,82 M42,8 L42,82 M50,8 L50,82 M58,8 L58,82 M66,8 L66,82 M74,9 L74,82">
                    <GeometryDrawing.Pen><Pen Brush="#FFFBFC" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFF3F4">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,27" RadiusX="1.3" RadiusY="1.3"/>
                            <EllipseGeometry Center="12,68" RadiusX="1.3" RadiusY="1.3"/>
                            <EllipseGeometry Center="88,27" RadiusX="1.3" RadiusY="1.3"/>
                            <EllipseGeometry Center="88,68" RadiusX="1.3" RadiusY="1.3"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="MainNavigationCard" TargetType="Button">
        <Setter Property="Width" Value="356"/>
        <Setter Property="Height" Value="304"/>
        <Setter Property="Background" Value="{StaticResource MainCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MainInk}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="CardRoot">
                        <!-- Only these small brushes animate. No layout, text, icon or shadow animation. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0.12"/>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.10"/>
                                    <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTintBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutlineBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="PressBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTintBrush" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutlineBrush" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="PressBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTintBrush" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutlineBrush" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="PressBrush" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTintBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutlineBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="PressBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- Cache just the static shadow, never the text or the icon. -->
                        <Border CornerRadius="32" Background="{TemplateBinding Background}" IsHitTestVisible="False">
                            <Border.CacheMode><BitmapCache/></Border.CacheMode>
                            <Border.Effect>
                                <DropShadowEffect Color="#DB475C" BlurRadius="28" ShadowDepth="18" Direction="270" Opacity="0.22" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Surface" CornerRadius="32" Background="{TemplateBinding Background}"/>
                        <Border CornerRadius="32" IsHitTestVisible="False">
                            <Border.Background><SolidColorBrush x:Name="HoverTintBrush" Color="#ED0010" Opacity="0"/></Border.Background>
                        </Border>
                        <Grid>
                            <Grid.Clip><RectangleGeometry Rect="0,0,356,304" RadiusX="32" RadiusY="32"/></Grid.Clip>
                            <Canvas Width="356" Height="304">
                                <Path Data="M0,280 C71,238 133,250 185,262 C245,279 302,255 356,214 L356,304 L0,304 Z"
                                      Fill="{StaticResource MainWaveBrush}"/>
                                <Path Data="M48,304 C140,252 218,278 278,268 C316,262 337,241 356,214 C326,277 290,292 241,304 Z"
                                      Fill="#FA1B27" Opacity="0.68"/>
                                <Path Data="M112,304 C205,267 276,304 356,229 C323,278 290,297 254,304 Z"
                                      Fill="#D90008" Opacity="0.62"/>
                                <Border Canvas.Left="114" Canvas.Top="28" Width="128" Height="128" CornerRadius="32"
                                        Background="{StaticResource MainTileBrush}" IsHitTestVisible="False">
                                    <Border.CacheMode><BitmapCache/></Border.CacheMode>
                                    <Border.Effect><DropShadowEffect Color="#DE7887" BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="0.18" RenderingBias="Performance"/></Border.Effect>
                                </Border>
                                <Border Canvas.Left="114" Canvas.Top="28" Width="128" Height="128" CornerRadius="32"
                                        Background="{StaticResource MainTileBrush}" BorderBrush="#FBE5E8" BorderThickness="1.5">
                                    <Image Source="{TemplateBinding Tag}" Width="92" Height="96" Stretch="Uniform"/>
                                </Border>
                            </Canvas>
                            <ContentPresenter Margin="10,164,10,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <Border CornerRadius="32" BorderBrush="#F5E0E5" BorderThickness="1.5" IsHitTestVisible="False"/>
                        <Border CornerRadius="32" IsHitTestVisible="False">
                            <Border.Background><SolidColorBrush x:Name="PressBrush" Color="Black" Opacity="0"/></Border.Background>
                        </Border>
                        <Border CornerRadius="32" BorderThickness="2" IsHitTestVisible="False">
                            <Border.BorderBrush><SolidColorBrush x:Name="HoverOutlineBrush" Color="#E50019" Opacity="0"/></Border.BorderBrush>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="35" Margin="-4" BorderBrush="#DD0012"
                                BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Tag" Value="{StaticResource MainCaptionSquareCorners}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0.08"/>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.04"/>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.06"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CaptionHoverBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    <DoubleAnimation Storyboard.TargetName="CaptionPressBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                </Storyboard></VisualState>
                                <VisualState x:Name="MouseOver"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CaptionHoverBrush" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0"/>
                                    <DoubleAnimation Storyboard.TargetName="CaptionPressBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                </Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CaptionHoverBrush" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    <DoubleAnimation Storyboard.TargetName="CaptionPressBrush" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0"/>
                                </Storyboard></VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}"/>
                        <Border CornerRadius="{TemplateBinding Tag}" IsHitTestVisible="False">
                            <Border.Background><SolidColorBrush x:Name="CaptionHoverBrush" Color="White" Opacity="0"/></Border.Background>
                        </Border>
                        <Border CornerRadius="{TemplateBinding Tag}" IsHitTestVisible="False">
                            <Border.Background><SolidColorBrush x:Name="CaptionPressBrush" Color="Black" Opacity="0"/></Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource MainCaptionButton}">
        <Setter Property="Tag" Value="{StaticResource MainCaptionCloseCorners}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Tag" Value="{StaticResource MainCaptionSquareCorners}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
