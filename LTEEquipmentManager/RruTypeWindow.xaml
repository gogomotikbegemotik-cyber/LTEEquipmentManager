<Window
    x:Class="LTEEquipmentManager.RruTypeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="RRU Type"
    Width="1250"
    Height="750"
    MinWidth="900"
    MinHeight="600"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="White"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="48"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="12"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="Styles/EquipmentWindows.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border
        Style="{StaticResource EquipmentFrame}"
        Background="{StaticResource EquipmentCaptionBrush}"
        BorderBrush="#D6C5CA"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="48" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                CornerRadius="30,30,0,0"
                Background="{StaticResource EquipmentPageBrush}"
                Panel.ZIndex="1"
                Margin="0,-1,0,0">
                <Grid
                    Margin="20,14,20,50">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="1.35*"
                            MinHeight="154" />
                        <RowDefinition
                            Height="12" />
                        <RowDefinition
                            Height="*"
                            MinHeight="154" />
                        <RowDefinition
                            Height="12" />
                        <RowDefinition
                            Height="*"
                            MinHeight="154" />
                    </Grid.RowDefinitions>
                    <GroupBox
                        Grid.Row="0"
                        Style="{StaticResource EquipmentSection}">
                        <GroupBox.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <Image
                                    Source="{StaticResource EquipmentRruIcon}"
                                    Width="28"
                                    Height="30" />
                                <TextBlock
                                    Text="RRU Types"
                                    Style="{StaticResource EquipmentSectionTitle}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="*" />
                                <RowDefinition
                                    Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                x:Name="dgRruTypes"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                SelectionMode="Single"
                                SelectionChanged="dgRruTypes_SelectionChanged"
                                Margin="0"
                                Style="{StaticResource EquipmentGrid}"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="ID"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"
                                        Width="55"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="55" />
                                    <DataGridTextColumn
                                        Header="Vendor ID"
                                        Binding="{Binding IdVendor}"
                                        Width="85"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="85" />
                                    <DataGridTextColumn
                                        Header="Name"
                                        Binding="{Binding Name}"
                                        Width="160"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="160" />
                                    <DataGridTextColumn
                                        Header="Type"
                                        Binding="{Binding Type}"
                                        Width="160"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="160" />
                                    <DataGridTextColumn
                                        Header="Placement ID"
                                        Binding="{Binding IdPlacementType}"
                                        Width="100"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="100" />
                                    <DataGridTextColumn
                                        Header="TRX"
                                        Binding="{Binding TrxCount}"
                                        Width="65"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="65" />
                                    <DataGridTextColumn
                                        Header="CU"
                                        Binding="{Binding CuCount}"
                                        Width="65"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="65" />
                                    <DataGridTextColumn
                                        Header="Power (W)"
                                        Binding="{Binding MaxPowerWatt}"
                                        Width="90"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}"
                                        MinWidth="90" />
                                    <DataGridTextColumn
                                        Header="Comment"
                                        Binding="{Binding Comment}"
                                        Width="*"
                                        MinWidth="150"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0">
                                <Button
                                    x:Name="btnRruAdd"
                                    Content="Add"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentAddGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnRruEdit"
                                    Content="Edit"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentEditGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnRruDelete"
                                    Content="Delete"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentDeleteGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnRruSave"
                                    Content="Save"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentSaveGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnRruCancel"
                                    Content="Cancel"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentCancelGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnRruRefresh"
                                    Content="Refresh"
                                    IsEnabled="False"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentRefreshGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox
                        Grid.Row="2"
                        Style="{StaticResource EquipmentSection}">
                        <GroupBox.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <Image
                                    Source="{StaticResource EquipmentPortsIcon}"
                                    Width="28"
                                    Height="30" />
                                <TextBlock
                                    Text="RRU Ports"
                                    Style="{StaticResource EquipmentSectionTitle}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="*" />
                                <RowDefinition
                                    Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                x:Name="dgRruPorts"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                SelectionMode="Single"
                                SelectionChanged="dgRruPorts_SelectionChanged"
                                Margin="0"
                                Style="{StaticResource EquipmentGrid}"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                                <DataGrid.Columns>
                                    <!-- ID порта -->
                                    <DataGridTextColumn
                                        Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                    <DataGridTextColumn
                                        Header="Port Number"
                                        Binding="{Binding PortNumber}"
                                        Width="110"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                    <DataGridTextColumn
                                        Header="Port Name"
                                        Binding="{Binding PortName}"
                                        Width="*"
                                        MinWidth="130"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                    <!-- Выбор типа порта -->
                                    <DataGridComboBoxColumn
                                        Header="Port Type"
                                        SelectedValueBinding="{Binding PortTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name"
                                        Width="150"
                                        ElementStyle="{StaticResource EquipmentComboDisplay}"
                                        EditingElementStyle="{StaticResource EquipmentComboEditor}" />
                                    <DataGridCheckBoxColumn
                                        Header="TX"
                                        Binding="{Binding Tx}"
                                        Width="65"
                                        ElementStyle="{StaticResource EquipmentCheckDisplay}"
                                        EditingElementStyle="{StaticResource EquipmentCheckEditor}" />
                                    <DataGridCheckBoxColumn
                                        Header="RX"
                                        Binding="{Binding Rx}"
                                        Width="65"
                                        ElementStyle="{StaticResource EquipmentCheckDisplay}"
                                        EditingElementStyle="{StaticResource EquipmentCheckEditor}" />
                                    <DataGridTextColumn
                                        Header="Power (W)"
                                        Binding="{Binding MaxPowerWatt}"
                                        Width="100"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0">
                                <Button
                                    x:Name="btnPortAdd"
                                    Content="Add"
                                    Click="btnPortAdd_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentAddGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnPortEdit"
                                    Content="Edit"
                                    Click="btnPortEdit_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentEditGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnPortDelete"
                                    Content="Delete"
                                    Click="btnPortDelete_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentDeleteGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnPortSave"
                                    Content="Save"
                                    IsEnabled="False"
                                    Click="btnPortSave_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentSaveGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnPortCancel"
                                    Content="Cancel"
                                    IsEnabled="False"
                                    Click="btnPortCancel_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentCancelGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnPortRefresh"
                                    Content="Refresh"
                                    Click="btnPortRefresh_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentRefreshGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox
                        Grid.Row="4"
                        Style="{StaticResource EquipmentSection}">
                        <GroupBox.Header>
                            <StackPanel
                                Orientation="Horizontal">
                                <Image
                                    Source="{StaticResource EquipmentStandardsIcon}"
                                    Width="28"
                                    Height="30" />
                                <TextBlock
                                    Text="Port Standards"
                                    Style="{StaticResource EquipmentSectionTitle}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="*" />
                                <RowDefinition
                                    Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                x:Name="dgRruPortStandards"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                SelectionMode="Single"
                                Margin="0"
                                Style="{StaticResource EquipmentGrid}"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="ID"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"
                                        Width="80"
                                        ElementStyle="{StaticResource EquipmentCellText}"
                                        EditingElementStyle="{StaticResource EquipmentEditingText}" />
                                    <!-- Выбираем название, сохраняем StandartId -->
                                    <DataGridComboBoxColumn
                                        Header="Standard"
                                        SelectedValueBinding="{Binding StandartId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="StandartName"
                                        Width="200"
                                        ElementStyle="{StaticResource EquipmentComboDisplay}"
                                        EditingElementStyle="{StaticResource EquipmentComboEditor}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0">
                                <Button
                                    x:Name="btnStandardAdd"
                                    Content="Add"
                                    Click="btnPortStandardAdd_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentAddGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnStandardEdit"
                                    Content="Edit"
                                    Click="btnStandardEdit_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentEditGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnStandardDelete"
                                    Content="Delete"
                                    Click="btnStandardDelete_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentDeleteGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnStandardSave"
                                    Content="Save"
                                    IsEnabled="False"
                                    Click="btnStandardSave_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentSaveGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnStandardCancel"
                                    Content="Cancel"
                                    IsEnabled="False"
                                    Click="btnStandardCancel_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentCancelGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                                <Button
                                    x:Name="btnStandardRefresh"
                                    Content="Refresh"
                                    Click="btnStandardRefresh_Click"
                                    Style="{StaticResource EquipmentActionButton}"
                                    Tag="{StaticResource EquipmentRefreshGeometry}"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Border>
            <Border
                Style="{StaticResource EquipmentCaption}"
                Background="{StaticResource EquipmentCaptionBrush}">
                <Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="27,0,150,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <Image
                            Source="{StaticResource EquipmentRruIcon}"
                            Width="28"
                            Height="34" />
                        <TextBlock
                            Text="RRU Type"
                            Foreground="White"
                            FontSize="22"
                            FontStyle="Italic"
                            FontWeight="SemiBold"
                            Margin="17,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button
                            Style="{StaticResource EquipmentCaptionButton}"
                            Click="MinimizeWindow_Click"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                            <Path
                                Stroke="White"
                                StrokeThickness="1.6"
                                Data="M0,0 H14"
                                Width="14" />
                        </Button>
                        <Button
                            Style="{StaticResource EquipmentCaptionButton}"
                            Click="ToggleMaximizeWindow_Click"
                            ToolTip="Maximize / Restore"
                            AutomationProperties.Name="Maximize or restore">
                            <Path
                                Stroke="White"
                                StrokeThickness="1.6"
                                Width="14"
                                Height="14"
                                Stretch="Uniform">
                                <Path.Style>
                                    <Style
                                        TargetType="Path">
                                        <Setter
                                            Property="Data"
                                            Value="M1,1 H15 V15 H1 Z" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized">
                                                <Setter
                                                    Property="Data"
                                                    Value="M5,1 H15 V11 M1,5 H11 V15 H1 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button
                            Style="{StaticResource EquipmentCloseCaptionButton}"
                            Click="CloseWindow_Click"
                            ToolTip="Close"
                            AutomationProperties.Name="Close">
                            <Path
                                Stroke="White"
                                StrokeThickness="1.6"
                                Data="M1,1 L15,15 M15,1 L1,15"
                                Width="14"
                                Height="14"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>