<Window x:Class="LTEEquipmentManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SQL Server Login" Width="800" Height="550" MinWidth="760" MinHeight="524"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="White" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/LoginWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="11" Background="{StaticResource LoginPageBackground}">
        <Grid ClipToBounds="True">
            <!-- Artwork fills the window; the form scales uniformly in a separate Viewbox. -->
            <Viewbox Stretch="Fill" IsHitTestVisible="False" Focusable="False">
                <Canvas Width="1280" Height="882">
                    <Path Data="M0,0 L604,0 C408,87 136,169 0,344 Z" Fill="#FBECEF"/>
                    <Path Data="M0,0 L559,0 C403,86 130,126 0,300 Z" Fill="#FFF5F6"/>
                    <Path Data="M0,0 L532,0 C407,73 158,72 0,155 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                <GradientStop Color="#F20009" Offset="0"/>
                                <GradientStop Color="#DE0006" Offset="0.6"/>
                                <GradientStop Color="#B10002" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M0,155 C123,72 257,80 397,0 C281,94 98,168 0,282 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0.8,0">
                                <GradientStop Color="#FF4D55" Offset="0"/>
                                <GradientStop Color="#FF3039" Offset="0.52"/>
                                <GradientStop Color="#F70C18" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M0,155 C123,72 257,80 397,0" Stroke="#FF7077" StrokeThickness="1" Opacity="0.5"/>
                    <Path Data="M1280,446 C1187,650 1090,722 904,765 C662,823 458,780 231,882 L1280,882 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
                                <GradientStop Color="#FFFDFD" Offset="0"/>
                                <GradientStop Color="#FBECEF" Offset="0.6"/>
                                <GradientStop Color="#F8DDE1" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M1280,478 C1163,689 1050,739 858,785 C658,831 483,799 318,835 C186,862 125,845 22,882 L1280,882 Z"
                          Fill="#FFF8F9" Opacity="0.85"/>
                    <Path Data="M0,882 C170,818 288,826 403,831 C590,839 717,838 868,783 C1087,704 1166,610 1224,453 C1170,700 1041,793 885,835 L1280,882 Z"
                          Fill="#F9E4E7" Opacity="0.42"/>
                    <Path Data="M363,882 C592,775 714,822 888,820 C1038,823 1114,744 1280,674 L1280,882 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.85,1">
                                <GradientStop Color="#FF111D" Offset="0"/>
                                <GradientStop Color="#ED0007" Offset="0.5"/>
                                <GradientStop Color="#C50003" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M643,882 C840,826 989,894 1152,738 C1054,864 969,874 923,882 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                <GradientStop Color="#FF535C" Offset="0"/>
                                <GradientStop Color="#FF2734" Offset="0.6"/>
                                <GradientStop Color="#EE0010" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M923,882 C1028,859 1092,810 1152,738 C1106,812 1087,855 1083,882 Z" Fill="#FF4B57" Opacity="0.5"/>
                </Canvas>
            </Viewbox>
            <Viewbox Stretch="Uniform">
                <Canvas Width="1280" Height="882">
                    <Path Fill="#E30009" AutomationProperties.Name="LTE"
                          Data="M312,120 L327,120 L317,157 L341,157 L337,169 L300,169 Z M340,120 L384,120 L381,131 L367,131 L357,169 L343,169 L353,131 L337,131 Z M387,120 L421,120 L418,131 L397,131 L395,138 L415,138 L412,149 L392,149 L390,158 L412,158 L409,169 L375,169 Z"/>
                    <TextBlock Canvas.Left="430" Canvas.Top="103" Text="Equipment Manager" FontSize="56" FontWeight="Bold" Foreground="#202020"/>
                    <Path Data="M734,109 C829,55 1005,66 1013,140 C1019,176 951,210 855,217 C929,202 987,171 995,144 C1002,104 870,57 734,109 Z"
                          Fill="#F0000B" IsHitTestVisible="False"/>
                    <Border Canvas.Left="192" Canvas.Top="235" Width="896" Height="507" CornerRadius="38"
                            BorderBrush="#F8E4E8" BorderThickness="1.5" Background="{StaticResource LoginCardBackground}">
                        <Border.Effect>
                            <DropShadowEffect Color="#AA3B4B" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.15"/>
                        </Border.Effect>
                    </Border>
                    <Grid Canvas.Left="244" Canvas.Top="264" Width="792" Height="336">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="79"/><ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="522"/><ColumnDefinition Width="6"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="84"/><RowDefinition Height="84"/>
                            <RowDefinition Height="84"/><RowDefinition Height="84"/>
                        </Grid.RowDefinitions>
                        <Canvas Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Left" Margin="9,-8,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path Fill="{StaticResource LoginRed}" Data="M4,3 Q0,3 0,7 L0,10 Q0,14 4,14 L35,14 Q39,14 39,10 L39,7 Q39,3 35,3 Z M4,15 Q0,15 0,19 L0,22 Q0,26 4,26 L35,26 Q39,26 39,22 L39,19 Q39,15 35,15 Z M4,27 Q0,27 0,31 L0,34 Q0,38 4,38 L35,38 Q39,38 39,34 L39,31 Q39,27 35,27 Z"/>
                            <Path Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6,8.5 L7,8.5 M27,8.5 L28,8.5 M33,8.5 L34,8.5 M6,20.5 L7,20.5 M27,20.5 L28,20.5 M33,20.5 L34,20.5 M6,32.5 L7,32.5 M27,32.5 L28,32.5 M33,32.5 L34,32.5"/>
                        </Canvas>
                        <Canvas Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Left" Margin="9,-8,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path Stroke="{StaticResource LoginRed}" StrokeThickness="3.8" Fill="White" StrokeLineJoin="Round" Data="M2,10 C2,1 36,1 36,10 L36,30 C36,40 2,40 2,30 Z"/>
                            <Path Stroke="{StaticResource LoginRed}" StrokeThickness="3.8" Fill="Transparent" Data="M2,10 C2,19 36,19 36,10 M2,20 C2,29 36,29 36,20 M2,29 C2,38 36,38 36,29"/>
                        </Canvas>
                        <Canvas Grid.Row="2" Width="40" Height="40" HorizontalAlignment="Left" Margin="9,-8,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path Stroke="{StaticResource LoginRed}" StrokeThickness="3.8" Fill="Transparent" StrokeLineJoin="Round" Data="M20,3 A9,9 0 1 1 19.99,3 M3,37 C3,19 37,19 37,37 Z"/>
                        </Canvas>
                        <Canvas Grid.Row="3" Width="40" Height="44" HorizontalAlignment="Left" Margin="9,-8,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path Stroke="{StaticResource LoginRed}" StrokeThickness="3.8" Fill="Transparent" StrokeLineJoin="Round" Data="M11,19 L11,12 C11,0 28,0 28,12 L28,19 M5,19 L34,19 L34,40 L5,40 Z"/>
                        </Canvas>
                        <Border Grid.Row="0" Width="1.5" Height="46" Background="#E1DFE2" HorizontalAlignment="Right"/>
                        <Border Grid.Row="1" Width="1.5" Height="46" Background="#E1DFE2" HorizontalAlignment="Right"/>
                        <Border Grid.Row="2" Width="1.5" Height="46" Background="#E1DFE2" HorizontalAlignment="Right"/>
                        <Border Grid.Row="3" Width="1.5" Height="46" Background="#E1DFE2" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Server" Margin="23,-10,0,0" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Database" Margin="23,-10,0,0" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Login" Margin="23,-10,0,0" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Password" Margin="23,-10,0,0" Style="{StaticResource LoginFieldLabel}"/>
                        <TextBox x:Name="txtServer" Grid.Row="0" Grid.Column="2" Height="52" Margin="0,-10,0,0" Style="{StaticResource LoginTextBox}"
                                 Text="(localdb)\MSSQLLocalDB" TabIndex="0" AutomationProperties.Name="Server"/>
                        <TextBox x:Name="txtDatabase" Grid.Row="1" Grid.Column="2" Height="52" Margin="0,-10,0,0" Style="{StaticResource LoginTextBox}"
                                 Text="lteDB" TabIndex="1" AutomationProperties.Name="Database"/>
                        <TextBox x:Name="txtLogin" Grid.Row="2" Grid.Column="2" Height="52" Margin="0,-10,0,0" Style="{StaticResource LoginTextBox}"
                                 Text="Evgenii" TabIndex="2" AutomationProperties.Name="Login"/>
                        <PasswordBox x:Name="txtPassword" Grid.Row="3" Grid.Column="2" Height="52" Margin="0,-10,0,0" Style="{StaticResource LoginPasswordBox}"
                                     TabIndex="3" AutomationProperties.Name="Password"/>
                        <Border Grid.Row="0" Grid.ColumnSpan="3" Height="1" Background="#EEECEE" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#EEECEE" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Background="#EEECEE" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                    </Grid>
                    <Button x:Name="btnConnect" Canvas.Left="244" Canvas.Top="618" Width="792" Height="78" Content="Connect"
                            Style="{StaticResource LoginConnectButton}" TabIndex="4" Click="btnConnect_Click"/>
                    <TextBlock x:Name="txtStatus" Canvas.Left="245" Canvas.Top="704" Width="790" Height="36" Foreground="Red"
                               FontSize="16" LineHeight="18" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </Canvas>
            </Viewbox>
            <!-- Native caption behavior comes from WindowChrome; buttons are client controls. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource LoginCaptionButton}" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M0,9 L18,9" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
                <Button Style="{StaticResource LoginCaptionButton}" Click="ToggleMaximizeWindow_Click" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize / Restore">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" Width="12" Height="12">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M1,1 L17,1 17,17 1,17 Z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Data" Value="M5,1 L17,1 17,13 M1,5 L13,5 13,17 1,17 Z"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Style="{StaticResource LoginCaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="Close" ToolTip="Close">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M1,1 L17,17 M17,1 L1,17" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

